{
  "name": "tmedit-org",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "IT部",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm types:generate && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && node scripts/configure-verify-store.mjs && pnpm db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply tmedit-org --remote --config wrangler.jsonc",
    "db:migration:create": "wrangler d1 migrations create tmedit-org --config wrangler.jsonc",
    "types:generate": "node scripts/generate-emdash-types.mjs",
    "typecheck": "pnpm types:generate && astro check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/auth": "^1.1.0",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "astro": "^7.3.4",
    "emdash": "^1.1.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@12.5.1"
}
