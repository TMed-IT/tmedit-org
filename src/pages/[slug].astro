---
import { decodeSlug } from "emdash";
import PageContent from "../components/PageContent.astro";
import CategoryArchive from "../components/CategoryArchive.astro";
import { getCategoryArchive } from "../lib/category-archive";
import { getPageRoute, pageHref } from "../lib/page-route";
import { disableSharedCache, isCampusRequest, privateRedirect } from "../lib/campus-access";
import { verificationPath } from "../lib/verify-client";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

// Existing fixed pages take precedence when a category has the same slug.
const route = await getPageRoute(slug, undefined, Astro.currentLocale);
const archive = route ? null : await getCategoryArchive(slug, Astro.cookies, Astro.currentLocale);
if (!route && !archive) return Astro.rewrite("/404");

if (route) {
	Astro.cache.set(route.cacheHint);
	if (route.page.data.campus_only) {
		disableSharedCache(Astro.cache, Astro.response.headers);
		Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
		if (!(await isCampusRequest(Astro.cookies))) return privateRedirect(verificationPath(Astro.url), Astro.response.headers);
	}
	const path = pageHref(route.page.id, route.page.data.terms?.category);
	if (path !== `/${encodeURIComponent(route.page.id)}`) {
		// Category assignments can change, so this redirect must not be permanent.
		disableSharedCache(Astro.cache, Astro.response.headers);
		return privateRedirect(path + Astro.url.search, Astro.response.headers);
	}
} else if (archive) {
	Astro.cache.set(archive.cacheHint);
	disableSharedCache(Astro.cache, Astro.response.headers);
}
---

{route ? <PageContent route={route} /> : archive && <CategoryArchive archive={archive} />}
