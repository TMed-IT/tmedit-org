---
import { verificationPath } from "../lib/verify-client";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { disableSharedCache, isCampusRequest } from "../lib/campus-access";

// No delivery destination is configured. Never accept or log personal details.
if (Astro.request.method === "POST") {
	return new Response("お問い合わせ窓口は準備中です。現在、このページからの送信は受け付けていません。", {
		status: 503,
		headers: { "Cache-Control": "private, no-store" },
	});
}

const { entry: page, cacheHint, error } = await getEmDashEntry("pages", "contact");
if (error && !(error instanceof Error && error.name === "LiveEntryNotFoundError")) throw error;
Astro.cache.set(cacheHint);

if (page?.data.campus_only) {
	disableSharedCache(Astro.cache, Astro.response.headers);
	Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
	if (!(await isCampusRequest(Astro.cookies))) return Astro.redirect(verificationPath(Astro.url));
}
---

<Base title="お問い合わせ" description="東邦大学医学部 IT部のお問い合わせ窓口の案内です。"
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}>
	<section class="contact-page">
		<p class="contact-page__label">CONTACT · IT CLUB</p>
		<h1>お問い合わせ</h1>
		{page?.data.content && <PortableText value={page.data.content} />}
		<p>お問い合わせ窓口は準備中です。受付方法が決まり次第、このページでご案内します。</p>
		<p>活動内容や参加については、ホームページのFAQもご確認ください。</p>
		<div class="contact-page__links">
			<a href="/#faq" class="btn btn-primary">よくある質問を見る <span aria-hidden="true">↗</span></a>
			<a href="https://github.com/tmed-it" class="btn btn-secondary" target="_blank" rel="noreferrer">公開プロジェクトを見る <span aria-hidden="true">↗</span></a>
		</div>
	</section>
</Base>

<style>
	.contact-page { width: min(100% - 2.5rem, 52rem); margin-inline: auto; padding-block: clamp(9rem, 18vw, 14rem) 8rem; }
	.contact-page__label { color: var(--color-accent); font: 600 var(--text-xs) var(--font-outlier); letter-spacing: .12em; }
	h1 { margin-block: 1.5rem 2rem; font-size: clamp(2.5rem, 7vw, 4rem); line-height: 1.1; }
	p { color: var(--color-ink-2); }
	.contact-page__links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
</style>
