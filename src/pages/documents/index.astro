---
import Base from "../../layouts/Base.astro";
import { documents, documentHref, pdfSize } from "../../lib/documents";
---

<Base title="規約・規程" description="東邦大学医学部IT部の規約と規程を掲載しています。本文の閲覧とPDF版のダウンロードができます。">
	<article class="documents-page">
		<nav class="documents-breadcrumbs" aria-label="パンくずリスト">
			<a href="/">ホーム</a><span aria-hidden="true">/</span><span>規約・規程</span>
		</nav>
		<header class="documents-heading">
			<p class="documents-label">IT CLUB</p>
			<h1>規約・規程</h1>
			<p>IT部の活動と運営に関する規約・規程です。<br />各文書の本文を読むか、PDF版をダウンロードしてご覧いただけます。</p>
		</header>
		<ul class="documents-list">
			{documents.map((document) => (
				<li>
					<h2><a href={documentHref(document.slug)}>{document.title}<span aria-hidden="true"> →</span></a></h2>
					<p>{document.description}</p>
					<div class="documents-actions">
						<a href={documentHref(document.slug)}>本文を読む</a>
						<a href={document.pdf} download={`${document.slug}.pdf`} aria-label={`${document.title}のPDFをダウンロード`}>PDFをダウンロード<span>（{pdfSize(document.bytes)}）</span></a>
					</div>
				</li>
			))}
		</ul>
	</article>
</Base>
