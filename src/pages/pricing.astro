---
import { verificationPath } from "../lib/verify-client";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { disableSharedCache, isCampusRequest } from "../lib/campus-access";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "pricing");

Astro.cache.set(cacheHint);

if (page?.data.campus_only) {
	disableSharedCache(Astro.cache, Astro.response.headers);
	Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
	if (!(await isCampusRequest(Astro.cookies))) return Astro.redirect(verificationPath(Astro.url));
}

const pageContent = page?.data.content;
---

<Base
	title="参加について"
	description="IT部の参加案内と活動に必要な費用について紹介します。"
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		pageContent ? (
			<PortableText value={pageContent} />
		) : (
			<div class="empty-state">
				<p class="empty-state__label">MEMBERSHIP</p>
				<h1>参加案内は準備中です。</h1>
				<p>管理画面から参加方法や費用に関する情報を追加できます。</p>
				<a href="/_emdash/api/auth/internal/authorize" class="btn btn-primary">
					管理画面を開く <span aria-hidden="true">↗</span>
				</a>
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		min-height: 74svh;
		display: grid;
		align-content: center;
		gap: var(--space-md);
		padding: var(--space-4xl) var(--page-gutter) var(--space-3xl);
		max-width: var(--page-max);
		margin-inline: auto;
	}

	.empty-state h1 {
		max-width: 14ch;
		font-size: var(--text-display-s);
		line-height: var(--leading-display);
		letter-spacing: var(--tracking-display);
	}

	.empty-state p {
		max-width: 48rem;
		color: var(--color-muted);
	}

	.empty-state .empty-state__label { color: var(--color-accent); font-family: var(--font-body); font-size: var(--text-xs); font-weight: 700; letter-spacing: var(--tracking-label); }
	.empty-state .btn { width: fit-content; margin-top: var(--space-sm); }
</style>
