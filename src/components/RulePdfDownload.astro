---
interface Props { source: string }
const { source } = Astro.props;
---
<div class="rule-pdf-download">
	<button type="button" class="btn btn-secondary" data-rule-pdf={source}>PDFをダウンロード</button>
	<p class="rule-pdf-status" role="status" aria-live="polite"></p>
	<noscript>PDFの生成にはJavaScriptを有効にしてください。</noscript>
</div>
<script>
	import regularJa from "../generated/rule-fonts/ShipporiMincho-Regular.ttf?url";
	import boldJa from "../generated/rule-fonts/ShipporiMincho-Bold.ttf?url";
	import regularLatin from "../generated/rule-fonts/LibertinusSerif-Regular.ttf?url";
	import boldLatin from "../generated/rule-fonts/LibertinusSerif-Bold.ttf?url";
	import italicLatin from "../generated/rule-fonts/LibertinusSerif-Italic.ttf?url";
	import boldItalicLatin from "../generated/rule-fonts/LibertinusSerif-BoldItalic.ttf?url";
	import type { RulePdfDocument } from "../lib/rule-pdf";

	let fonts: Promise<{ fontKey: string; data: ArrayBuffer }[]> | undefined;
	function loadFonts() {
		return fonts ??= Promise.all([
			["ShipporiMincho-Regular", regularJa], ["ShipporiMincho-Bold", boldJa],
			["LibertinusSerif-Regular", regularLatin], ["LibertinusSerif-Bold", boldLatin],
			["LibertinusSerif-Italic", italicLatin], ["LibertinusSerif-BoldItalic", boldItalicLatin],
		].map(async ([fontKey, path]) => {
			const response = await fetch(path);
			if (!response.ok) throw new Error("フォントを読み込めませんでした。");
			return { fontKey, data: await response.arrayBuffer() };
		})).catch((error) => { fonts = undefined; throw error; });
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-rule-pdf]")) {
		button.addEventListener("click", async () => {
			const status = button.parentElement!.querySelector<HTMLElement>(".rule-pdf-status")!;
			button.disabled = true;
			status.textContent = "PDFを生成しています…";
			try {
				const source = button.dataset.rulePdf!;
				const response = await fetch(source, { redirect: "manual", cache: "no-store" });
				if (response.type === "opaqueredirect" || response.status === 401) {
					const returnTo = new URL(source, location.href).pathname.replace(/\/document$/, "");
					location.assign(`/auth/verify/start?returnTo=${encodeURIComponent(returnTo)}`);
					return;
				}
				if (!response.ok) throw new Error("文書を取得できませんでした。時間をおいてもう一度お試しください。");
				const document: RulePdfDocument = await response.json();
				const [{ renderRulePdf }, data] = await Promise.all([import("../lib/rule-pdf"), loadFonts()]);
				const pdf = await renderRulePdf(document, data);
				const link = window.document.createElement("a");
				link.href = URL.createObjectURL(new Blob([new Uint8Array(pdf)], { type: "application/pdf" }));
				link.download = `${document.slug.replace(/[\\/\x00-\x1f]/g, "-")}.pdf`;
				link.click();
				setTimeout(() => URL.revokeObjectURL(link.href), 60_000);
				status.textContent = "PDFをダウンロードしました。";
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : "PDFを生成できませんでした。";
			} finally { button.disabled = false; }
		});
	}
</script>
