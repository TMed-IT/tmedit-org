---
interface Props {
	node: {
		headline?: string;
		testimonials: Array<{
			quote: string;
			author: string;
			role?: string;
			company?: string;
			avatar?: string;
		}>;
	};
}

const { node } = Astro.props;
const { headline, testimonials } = node;
---

<section class="testimonials section">
	<div class="container">
		{headline && (
			<header class="section-header">
				<h2 class="section-headline">{headline}</h2>
			</header>
		)}
		<div class="testimonials-grid">
			{testimonials.map((testimonial) => (
				<div class="testimonial-card">
					<blockquote class="testimonial-quote">
					“{testimonial.quote}”
					</blockquote>
					<div class="testimonial-author">
						<span class="testimonial-avatar" aria-hidden="true">{testimonial.author.slice(0, 1)}</span>
						<div class="testimonial-info">
							<span class="testimonial-name">{testimonial.author}</span>
							{(testimonial.role || testimonial.company) && (
								<span class="testimonial-role">
									{testimonial.role}
									{testimonial.role && testimonial.company && " at "}
									{testimonial.company}
								</span>
							)}
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.testimonials {
		background: var(--color-paper-2);
		color: var(--color-ink);
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: var(--rule-hair) solid var(--color-rule);
		border-inline-start: var(--rule-hair) solid var(--color-rule);
	}

	.testimonial-card {
		min-width: 0;
		min-height: 20rem;
		padding: clamp(var(--space-md), 3vw, var(--space-lg));
		background: var(--color-paper);
		color: var(--color-ink);
		border-inline-end: var(--rule-hair) solid var(--color-rule);
		border-bottom: var(--rule-hair) solid var(--color-rule);
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.testimonial-quote {
		font-family: var(--font-display);
		font-style: normal;
		font-size: clamp(var(--text-lg), 3vw, var(--text-xl));
		line-height: var(--leading-heading);
		color: var(--color-ink);
		flex: 1;
	}

	.testimonial-author {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.testimonial-avatar {
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		background: var(--color-accent-soft);
		color: var(--color-ink);
		border: var(--rule-hair) solid var(--color-accent-dim);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.testimonial-info {
		display: flex;
		flex-direction: column;
	}

	.testimonial-name {
		font-weight: 700;
		font-size: var(--text-sm);
	}

	.testimonial-role {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		color: var(--color-muted);
	}

	@media (max-width: 40rem) {
		.testimonials-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
