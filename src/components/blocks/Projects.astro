---
interface GithubRepository {
	name: string;
	description: string | null;
	html_url: string;
	stargazers_count: number;
	forks_count: number;
	pushed_at: string;
	language: string | null;
}

interface Props {
	node: {
		_key?: string;
		headline?: string;
		subheadline?: string;
		organization?: string;
		githubUrl?: string;
		maxProjects?: number;
	};
}

const { node } = Astro.props;
const organization = node.organization?.trim() || "tmed-it";
const githubUrl = node.githubUrl?.trim() || `https://github.com/${organization}`;
const maxProjects = Math.max(1, Math.min(Number(node.maxProjects) || 5, 12));
let projects: GithubRepository[] = [];

try {
	const response = await fetch(`https://api.github.com/orgs/${encodeURIComponent(organization)}/repos?type=public&per_page=100`, {
		headers: { Accept: "application/vnd.github+json" },
	});
	if (response.ok) {
		projects = ((await response.json()) as GithubRepository[])
			.toSorted((a, b) => b.stargazers_count - a.stargazers_count)
			.slice(0, maxProjects);
	}
} catch {
	projects = [];
}

const formatDate = (value: string) => new Intl.DateTimeFormat("ja-JP", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
}).format(new Date(value));
---

<section class="club-section" id={node._key || "projects"}>
	<div class="club-container">
		<header class="club-section__header reveal" data-reveal>
			{node.headline && <h2>{node.headline}</h2>}
			{node.subheadline && <p>{node.subheadline}</p>}
		</header>

		{projects.length > 0 ? (
			<div class="projects-grid">
				{projects.map((project, index) => (
					<a
						href={project.html_url}
						target="_blank"
						rel="noreferrer"
						class:list={["project", "reveal", { "project--lead": index === 0 }]}
						data-reveal
						data-reveal-delay={String(Math.min(index * 60, 300))}
					>
						<div class="project__title-row">
							<h3>{project.name}</h3>
							<span class="project__arrow" aria-hidden="true">↗</span>
						</div>
						<p>{project.description || "公開リポジトリで開発内容を確認できます。"}</p>
						<div class="project__meta">
							{project.language && <span class="project__language">{project.language}</span>}
							<span aria-label={`${project.stargazers_count} stars`}>☆ {project.stargazers_count}</span>
							<span aria-label={`${project.forks_count} forks`}>⑂ {project.forks_count}</span>
							<time datetime={project.pushed_at}>{formatDate(project.pushed_at)}</time>
						</div>
					</a>
				))}
			</div>
		) : (
			<div class="projects-empty reveal" data-reveal>
				<div>
					<h3>公開準備中です</h3>
					<p>新しいプロジェクトを公開次第、こちらに追加します。</p>
				</div>
			</div>
		)}

		<div class="projects-more reveal" data-reveal data-reveal-delay="240">
			<a href={githubUrl} target="_blank" rel="noreferrer">GitHubですべて見る <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</section>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-top: var(--rule-hair) solid var(--color-rule);
		border-inline-start: var(--rule-hair) solid var(--color-rule);
	}

	.project {
		min-width: 0;
		display: grid;
		align-content: space-between;
		min-height: 18rem;
		padding: clamp(var(--space-md), 3vw, var(--space-lg));
		background: var(--color-paper-2);
		color: var(--color-ink);
		border-inline-end: var(--rule-hair) solid var(--color-rule);
		border-bottom: var(--rule-hair) solid var(--color-rule);
	}

	.project--lead {
		grid-column: 1 / -1;
		min-height: 24rem;
		background: var(--color-paper-3);
	}

	.project__title-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.project h3 {
		font-size: clamp(var(--text-xl), 4vw, var(--text-3xl));
		line-height: var(--leading-heading);
		letter-spacing: var(--tracking-display);
		transition: color var(--dur-short) var(--ease-out);
	}

	.project__arrow {
		color: var(--color-accent);
		font-family: var(--font-body);
		font-size: var(--text-xl);
		transition: transform var(--dur-short) var(--ease-out);
	}

	.project > p {
		max-width: 58ch;
		margin-top: var(--space-lg);
		color: var(--color-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.project__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
		color: var(--color-muted);
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}

	.project__language {
		color: var(--color-accent);
		font-weight: 700;
	}

	.projects-empty {
		min-height: 20rem;
		display: grid;
		place-items: center;
		padding: var(--space-lg);
		background: var(--color-paper-2);
		color: var(--color-ink);
		border: var(--rule-hair) solid var(--color-rule);
		text-align: center;
	}

	.projects-empty h3 {
		font-size: var(--text-2xl);
	}

	.projects-empty p {
		margin-top: var(--space-xs);
		color: var(--color-muted);
	}

	.projects-more {
		display: flex;
		justify-content: flex-end;
		margin-top: var(--space-lg);
	}

	.projects-more a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		padding-inline: var(--space-sm);
		color: var(--color-accent);
		border: var(--rule-hair) solid var(--color-accent);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 700;
		white-space: nowrap;
	}

	@media (hover: hover) and (pointer: fine) {
		.project:hover h3 { color: var(--color-accent); }
		.project:hover .project__arrow { transform: translate(var(--space-3xs), calc(var(--space-3xs) * -1)); }
		.projects-more a:hover { background: var(--color-accent); color: var(--color-accent-ink); }
	}

	@media (max-width: 40rem) {
		.projects-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.project--lead {
			grid-column: auto;
			min-height: 20rem;
		}
	}
</style>
