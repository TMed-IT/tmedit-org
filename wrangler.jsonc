{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tmedit-org",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tmedit.org", "custom_domain": true },
  ],
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTH_URL": "https://auth.tmedit.org",
    "EMAIL_FROM": "noreply@tmedit.org",
    "EMAIL_FROM_NAME": "IT部",
    "SITE_URL": "https://tmedit.org",
  },
  // Local store placeholder; scripts/configure-verify-store.mjs sets the production ID.
  "secrets_store_secrets": [
    { "binding": "VERIFY_CLIENT_SECRET", "store_id": "00000000000000000000000000000000", "secret_name": "CLIENT_SECRET_TMEDIT" },
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@tmedit.org"],
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tmedit-org",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tmedit-org-media",
    },
  ],
  // Astro sessions: KV namespace tmedit-org.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "f7ea9f2d7add42aeb9661565be9ebcaf",
    },
  ],
  // Worker Loader for plugin sandboxing
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  // Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
  "triggers": {
    "crons": ["* * * * *"],
  },
}
