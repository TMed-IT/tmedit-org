# internal認証サービスのOrigin
AUTH_URL=https://internal-auth.example.com

# 初回管理者以外を自動作成するときのEmDashロール（任意、既定値: 30=Author）
# AUTH_DEFAULT_ROLE=30

# お知らせメールに記載する公開サイトのURL
SITE_URL=https://tmedit.org

# verifyと同じSecrets StoreのID（秘密値ではありません）
# デプロイ前にシェル、またはGitHub ActionsのVariablesへ設定します。
# CLOUDFLARE_SECRETS_STORE_ID=your-store-id
